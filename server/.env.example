# Server Configuration
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# Server port (default: 3001)
PORT=3001

# Admin key for protecting /api/orders and admin page
# Generate a secure random string for production
ADMIN_KEY=your-secure-random-key-here

# Groq API key for the website chatbot (/api/chat)
GROQ_API_KEY=your-groq-api-key-here

# Brevo transactional email (contact form -> owner inbox)
BREVO_API_KEY=your-brevo-api-key-here
NOTIFY_EMAIL=nancydhull72@gmail.com
SENDER_EMAIL=nancydhull72@gmail.com
SENDER_NAME=Dhull Cosmetic Shop
